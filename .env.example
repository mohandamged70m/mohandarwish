# Public deployment URL; this is not a secret.
NEXT_PUBLIC_CONVEX_URL=
# Owner sign-in (Auth.js "Sign in with Google"). Server-only: never prefix
# these with NEXT_PUBLIC_.
#
# DASHBOARD_OWNER_EMAIL — your Gmail address. Only this address (compared
# case-insensitively, with Google's verified-email claim required) may use
# /dashboard and the private APIs. Everyone else is denied.
DASHBOARD_OWNER_EMAIL=
# AUTH_SECRET — random secret (at least 32 characters) that encrypts Auth.js
# sessions. Generate with: npx auth secret
# (or: openssl rand -base64 32). Rotating it signs every session out.
AUTH_SECRET=
# Google OAuth client for Auth.js. Create it in Google Cloud Console:
# APIs & Services > Credentials > Create Credentials > OAuth client ID
# (Application type: Web application). See README for the exact redirect URIs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional per-visitor rate-limit key. Falls back to AUTH_SECRET when unset;
# set an independent value if you rotate AUTH_SECRET often.
RATE_LIMIT_SECRET=
# Set the same value in the Convex deployment environment.
CONVEX_SERVER_KEY=
# Optional base URL for Auth.js (production). When unset, Auth.js trusts the
# incoming host headers (trustHost). Set it if sign-in redirects misbehave:
# AUTH_URL=https://your-domain.vercel.app
# Existing optional email and calendar integrations.
RESEND_API_KEY=
RESEND_FROM=
OWNER_EMAIL=
MEETING_SYNC_URL=
# GitHub personal access token, server-side only (never prefixed NEXT_PUBLIC_).
# Powers the Developer tab: contribution calendar via the GraphQL API
# (contributionsCollection), plus stars/forks/repo counts and streaks.
# Classic PAT needs `read:user`; a fine-grained PAT needs read access to
# profile data. Set it in Vercel -> Settings -> Environment Variables AND in
# .env.local. Without it the Developer tab falls back to its cached snapshot
# and a "couldn't load activity" state rather than fake numbers.
GITHUB_TOKEN=
